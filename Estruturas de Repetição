import java.util.Scanner;

public class EstRpt3 {
    public static void main(String[] args) {
        Scanner ler = new Scanner(System.in);

        int n, soma = 0;

        System.out.println("Digite um valor inteiro e positivo: ");
        n = ler.nextInt();

        if (n > 0) {
            for (int i = 1; i < n; i++) {
                if (n % i == 0) {
                    soma += i;
                }
            }
            if (n == soma) {
                System.out.printf("%d é um número perfeito", n);
            }
            else {
                System.out.printf("%d não é um número perfeito", n);
            }
        }
        else {
            System.out.println("Numero inválido");
        }
    }
}


import java.util.Scanner;

public class EstRpt4 {
    public static void main(String[] args) {
        Scanner ler = new Scanner(System.in);

        int nA , nB ;

        do {
            System.out.println("Digite dois numeros");
            nA = ler.nextInt();
            nB = ler.nextInt();
            if (nA < nB){
                System.out.println("Digiteado em ordem crescente\n");
            }
            else if (nA == nB){
                System.out.println("Numeros iguais, encerrando..\n");
            }
            else {
                System.out.println("Digitado em ordem decrescente\n");
            }
        }
        while (nA != nB);
    }
}
import java.util.Scanner;

public class EstRpt6 {
    public static void main(String[] args) {
        Scanner ler = new Scanner(System.in);

        int numero;
        do {
            System.out.println("Digite um numero");
            numero = ler.nextInt();
            for (int i = 1 ; i < 11 ; i++ ){
                int tabuada = (numero * i);
                System.out.printf( numero + " * " + i + " = " + tabuada +"\n");
            }
        }while (numero > -1 );
    }
}

public class EstRpt8 {
    public static void main(String[] args) {
            int contador = 0 ;
            int n = 0;

            System.out.println(  " 50 primeiros numeros primos após o 100:\n");

            while(contador < 50){
                boolean primo = true;

                for(int i = 2; i <= (n / 2); i++){
                    if(n % i == 0){
                        primo = false;
                        break;
                    }
                }

                if((primo) && (n > 100)){
                    System.out.printf("%6d", n);
                    contador++;

                    if(contador % 10 == 0){
                        System.out.println();
                    }
                }
                n++;
            }
        }
    }

