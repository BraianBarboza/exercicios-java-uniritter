import java.util.Scanner;
public class EstRpt1 {
    public static void main(String[] args) {
        Scanner ler = new Scanner(System.in);
        int somaP = 0, somaIm = 0, p = 0, im = 0, n;

        System.out.println("Digite um valor inteiro e positivo: ");
        n = ler.nextInt();

        if (n > 0) {
            for (int i = 1; i <= n; i++) {
                if (i % 2 == 0) {
                    p++;
                    somaP += i;
                } else {
                    im++;
                    somaIm += i;
                }
            }
            System.out.printf("Quantidade de números pares entre 1 e %d: %d%n", n, p);
            System.out.println("Soma dos números pares: " + somaP);
            System.out.printf("Quantidade de números impares entre 1 e %d: %d%n", n, im);
            System.out.println("Soma dos números impares: " + somaIm);
        } else {
            System.out.println("Numero inválido");
        }
    }
}

