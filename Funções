import java.util.Scanner;

public class Metodos8 {
    public static void main(String[] args) {

        int[] a = new int[30];
        int[] b = new int[30];
        int[] c = new int[30];
        int indiceC = 0;

        getVetorA(a);
        getVetorB(b);
        getVetorC(a, b, c, indiceC);
    }

    public static void getVetorA(int[] a) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("Digite os 30 valores do vetor A:");

        for (int i = 0; i < 30; i++) {
            a[i] = scanner.nextInt();
        }
    }

    public static void getVetorB(int[] b) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("Digite os 30 valores do vetor B:");
        for (int i = 0; i < 30; i++) {
            b[i] = scanner.nextInt();
        }
    }

    public static void getVetorC(int[] a, int[] b, int[] c, int indiceC) {

        for (int i = 0; i < 30; i++) {
            for (int j = 0; j < 30; j++) {
                if (a[i] == b[j]) {
                    c[indiceC++] = a[i];
                }
            }
        }
        System.out.println("\nInterseção de A e B:");
        for (int i = 0; i < indiceC; i++) {
            System.out.println("Elemento " + (i + 1) + ": " + c[i]);
        }
    }
}



public class Metodos9 {
    public static void main(String[] args) {

        int[][] numeros = new int[7][9];
        int somaNumeros = 0;

        somaMatriz(numeros, somaNumeros);
    }
    public static void somaMatriz(int[][] numeros, int somaNumeros){
        for (int i = 0; i < numeros.length; i++) {
            for (int j = 0; j < numeros[i].length; j++) {
                numeros[i][j] = (int)(Math.random() * 10 + 1);
                somaNumeros +=numeros[i][j];
                System.out.print(numeros[i][j] + " | ");
            }
            System.out.println();
        }
        System.out.printf("Soma de todos os elementos %d", somaNumeros);
    }
    }

import java.util.Random;

public class Metodos10 {
    public static void main(String[] args) {

        int[][] numeros = new int[6][8];
        int[] vC = new int[6];

        getVetorC(numeros, vC);
        printVetorC(numeros, vC);
    }
    public static void getVetorC(int[][] numeros, int[] vC ) {
        Random random = new Random();

        for (int i = 0; i < numeros.length; i++) {
            for (int j = 0; j < numeros[i].length; j++) {
                numeros[i][j] = random.nextInt(-20, 20);
                System.out.print(numeros[i][j] + " | ");
                if (numeros[i][j] < 0) {
                    vC[i]++;
                }
            }
            System.out.println();
        }
    }
    public static void printVetorC(int[][] numeros, int[] vC){
        System.out.println("Numero de negativos:");
        for (int i = 0; i < numeros.length; i++) {
            System.out.print(vC[i] + " | ");
        }
    }
}

import java.util.Random;

public class Metodos11 {
    public static void main(String[] args) {
        int[][] m = new int[10][10];
        int soma = 0;
        printMatriz(m);
        mediaDiagonal(soma, m);

    }

    public static void printMatriz(int[][] m) {
        Random random = new Random();
        for (int i = 0; i < m.length; i++) {
            for (int j = 0; j < m[i].length; j++) {
                m[i][j] = (random.nextInt(1, 10));
                System.out.printf("%d | ", m[i][j]);
            }
            System.out.println();
        }
    }

    public static void mediaDiagonal(int soma, int[][] m) {
        for (int i = 0; i < m.length; i++) {
            for (int j = 0; j < m[i].length; j++) {
                if (i == j) {
                    soma += m[i][j];
                }
            }
        }
        float media = (float) soma / 10;
        System.out.printf("Media da diagonal principal: %.2f", media);
    }
}


