import java.util.Scanner;

public class Matriz9 {

        public static void main(String[] args) {
            Scanner ler = new Scanner(System.in);
            int[][] m = new int[3][3];
            double somaD = 0;
            System.out.println("Digite os valores da matriz M: ");
            for (int i = 0; i < m.length; i++) {
                for (int j = 0; j < m[i].length; j++) {
                    m[i][j] = ler.nextInt();
                }
            }
            for (int i = 0; i < m.length; i++) {
                for (int j = 0; j < m[i].length; j++) {
                   System.out.printf("%d | ",m[i][j]);
                }
                System.out.println();
            }
            System.out.println("Diagonal principal: ");
            for (int i = 0; i < m.length; i++) {
                System.out.print(m[i][i] + " | ");
            }
            System.out.println("\nDiagonal secundária: ");
            for (int i = 0; i < m.length; i++) {
                for (int j = 0; j < m[i].length; j++) {
                    if (i + j == m.length - 1) {
                        System.out.print(m[i][j] + " | ");
                        somaD += m[i][j];
                    }
                }
            }
            double mediaDS = somaD / 3;
            System.out.printf("\nMédia da diagonal secundária: %.2f\n", mediaDS);
            System.out.println("Multiplicação dos valores: ");
            for (int i = 0; i < m.length; i++) {
                for (int j = 0; j < m[i].length; j++) {
                    if (i == j) {
                        System.out.print(m[i][j] * mediaDS + " | ");
                    }
                }
            }
        }
    }

