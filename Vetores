import java.util.Arrays;
import java.util.Scanner;

public class Vetores12 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int[] vetor = new int[6];
        int soma=0, produto=1, somaMedia=0;

        System.out.println("Digite 6 numeros");
        for (int i = 0; i < 6; i++) {
            System.out.print("Elemento " + (i + 1) + ": ");
            vetor[i] = scanner.nextInt();
        }

        System.out.print("\nEscolha a opção desejada:\n 1- Soma dos elementos\n 2- Produto dos elementos \n 3- Média dos elementos \n 4- Mostre o vetor");
        int opcao = scanner.nextInt();

        switch (opcao) {
            case 1:

                for (int num : vetor) {
                    soma += num;
                }
                System.out.println("Soma dos elementos: " + soma);
                break;
            case 2:
                for (int num : vetor) {
                    produto *= num;
                }
                System.out.println("Produto dos elementos: " + produto);
                break;
            case 3:
                for (int num : vetor) {
                    somaMedia += num;
                }
                double media = (double) somaMedia / vetor.length;
                System.out.println("Média dos elementos: " + media);
                break;
            case 4:
                System.out.println("Vetor:");
                    System.out.print(Arrays.toString(vetor));
                break;
            default:
                System.out.println("Opção inválida!");
        }
    }
}
import java.util.Scanner;

public class Vetores13 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int[] a = new int[30];
        int[] b = new int[30];
        int[] c = new int[30];

        System.out.println("Digite os 30 valores do vetor A:");
        for (int i = 0; i < 30; i++) {
            a[i] = scanner.nextInt();
        }

        System.out.println("Digite os 30 valores do vetor B:");
        for (int i = 0; i < 30; i++) {
            b[i] = scanner.nextInt();
        }

        int indiceC = 0;

        for (int i = 0; i < 30; i++) {
            for (int j = 0; j < 30; j++) {
                if (a[i] == b[j]) {
                    c[indiceC++] = a[i];
                    break;
                }
            }
        }

        System.out.println("\nInterseção de A e B:");
        for (int i = 0; i < indiceC; i++) {
            System.out.println("Elemento " + (i + 1) + ": " + c[i]);
        }
    }
}
