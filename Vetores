import java.util.Scanner;

public class Vetores10 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int[] pares = new int[10];
        int[] impares = new int[10];
        int qdePar = 0, qdeImpar=0;


        System.out.println("Digite os valores \n(digite 0 para sair)");

        while (true) {
            int numero = scanner.nextInt();

            if (numero == 0 || qdePar == 10 || qdeImpar == 10) {
                break;
            }

            if (numero % 2 == 0) {
                pares[qdePar++] = numero;
            } else {
                impares[qdeImpar++] = numero;
            }
        }

        System.out.println("\nVetor de pares:");
        for (int i = 0; i < qdePar; i++) {
            System.out.print(pares[i] + " ");
        }

        System.out.println("\nVetor de ímpares:");
        for (int i = 0; i <qdeImpar; i++) {
            System.out.print(impares[i] + " ");
        }
    }
}
