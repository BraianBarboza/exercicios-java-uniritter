import java.util.Scanner;

public class ProgSeq4 {
    public static void main(String[] args) {
        Scanner ler = new Scanner(System.in);

        float x;

        System.out.println("Digite o X");
        x = ler.nextFloat();

        System.out.println("Numero: " + x);

        float quad = ( x * x );
        System.out.println("O Quadrado de X é: " + quad );

        float resto = ( x % 3 );
        System.out.println("O Resto da divisão de X por 3 é: " + resto);

        float metade = ( x/2 );
        System.out.printf("A metade de X é: %.2f\n" , metade );

        float multDiv = ( quad/2 );
        System.out.printf("A metade do produto de X é: %.2f" , multDiv );

    }
}


