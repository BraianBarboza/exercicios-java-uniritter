import java.util.Scanner;

public class Selec10 {
    public static void main(String[] args) {
        Scanner ler = new Scanner(System.in);

        int menu;

        System.out.printf("------Lista de Produtos e Preços------ %n 1.Banana -> R$ 0.30 preço a granel ou R$ 0.25 preço a duzia ou mais %n 2.Laranja -> R$ 0.40 preço a granel ou R$ 0.35 preço a duzia ou mais %n 3.Maçã -> R$ 0.50 preço a granel ou R$ 0.45 preço a duzia ou mais %n 4.Kiwi -> R$ 0.40 preço a granel ou R$ 0.30 preço a duzia ou mais %n ");

        System.out.println("Escolha o produto desejado ou digite -1 para sair:");
        menu = ler.nextInt();

        switch (menu) {
            case 1:
                System.out.println("Escolha a quantidade de bananas desejada:");
                int ban = ler.nextInt();
                if (ban >= 12) {
                    double duziaBan = ban * 0.25;
                    System.out.printf("---valor da compra--- %n%d unidades de banana a 0,25 a unidade = %.2f", ban, duziaBan);
                } else {
                    double bans = ban * 0.30;
                    System.out.printf("---valor da compra--- %n%d unidade(s) de banana a 0,30 a unidade = %.2f", ban, bans);
                }
                break;
            case 2:
                System.out.println("Escolha a quantidade de laranjas desejada:");
                int lar = ler.nextInt();
                if (lar >= 12) {
                    double duziaLar = lar * 0.35;
                    System.out.printf("---valor da compra--- %n%d unidades de laranja a 0,35 a unidade = %.2f", lar, duziaLar);
                } else {
                    double lars = lar * 0.40;
                    System.out.printf("---valor da compra--- %n%d unidade(s) de laranja a 0,40 a unidade = %.2f", lar, lars);
                }
                break;
            case 3:
                System.out.println("Escolha a quantidade de maçãs desejada:");
                int mac = ler.nextInt();
                if (mac >= 12) {
                    double duziaMac = mac * 0.45;
                    System.out.printf("---valor da compra--- %n%d unidades de maçã a 0,45 a unidade = %.2f", mac, duziaMac);
                } else {
                    double macs = mac * 0.50;
                    System.out.printf("---valor da compra--- %n%d unidade(s) de maçã a 0,50 a unidade = %.2f", mac, macs);
                }
                break;
            case 4:
                System.out.println("Escolha a quantidade de kiwis desejada:");
                int kiw = ler.nextInt();
                if (kiw >= 12) {
                    double duziaKiw = kiw * 0.30;
                    System.out.printf("---valor da compra--- %n%d unidades de kiwi a 0,30 a unidade = %.2f", kiw, duziaKiw);
                } else {
                    double kiws = kiw * 0.40;
                    System.out.printf("---valor da compra--- %n%d unidade(s) de kiwi a 0,40 a unidade = %.2f", kiw, kiws);
                }
                break;
            case -1:
                System.out.println("Operação finalizada");
                break;
        }

    }
}
